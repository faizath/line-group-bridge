{
  "name": "line-group-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Relays messages between LINE group chats so several groups behave like one community",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "lgb": "dist/cli/lgb.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "migrate": "node dist/db/migrate-cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "fake-line": "tsx test/fake-line/cli.ts",
    "load-test": "tsx scripts/load-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "@electric-sql/pglite": "^0.5.8",
    "@line/bot-sdk": "^11.3.0",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/autocannon": "^7.12.7",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "autocannon": "^8.0.0",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  }
}

# LINE Official Account Credentials (from LINE Developers Console)
LINE_CHANNEL_SECRET=your_channel_secret_here
LINE_ACCESS_TOKEN=your_channel_access_token_here
LINE_CHANNEL_ID=your_channel_id_here
LINE_TOKEN_MODE=long_lived

# Service Configuration
ROLE=all
PORT=8080
ADMIN_PORT=8081
DATABASE_URL=postgres://lgb:lgb_password@postgres:5432/lgb

# Media and Object Storage
MEDIA_BACKEND=s3
S3_ENDPOINT=http://minio:9000
S3_BUCKET=lgb-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
MEDIA_PUBLIC_BASE_URL=https://bridge.example.com

# Administration & Roles
OPERATOR_USER_IDS=U0123456789abcdef0123456789abcdef
# Generate admin token hash with: npx tsx src/cli/lgb.ts hash-token <plain-token>
ADMIN_API_TOKENS=

# Delivery & Quota
DEFAULT_DELIVERY_MODE=batched
BATCH_WINDOW_MS=3000
ECONOMY_MAX_HOLD_S=600
QUOTA_ALERT_PCT=80
QUOTA_HARD_PCT=95
QUOTA_TZ=Asia/Tokyo
